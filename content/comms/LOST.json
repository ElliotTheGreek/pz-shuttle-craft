        { "voice": "card", "text": "INCOMING: U.S.S. ADIRONDACK" },
        { "voice": "shepard", "text": "It's Shepard. %2's beacon stopped an hour ago." },
        { "voice": "shepard", "text": "I don't blame you. I just wanted somebody else" },
        { "voice": "shepard", "text": "to hear the name out loud." }
      ],
      "options": [
        { "text": "I couldn't get there.", "go": "02" },
        { "text": "I'm sorry.", "go": "02" },
        { "text": "There'll be others.", "go": "03" }
      ],
      "clears": ["lostDue"]
    },
    {
      "id": "02",
      "lines": [
        { "voice": "shepard", "text": "I know. Nobody could. Shepard out." }
      ]
    },
    {
      "id": "03",
      "lines": [
        { "voice": "shepard", "text": "There will. That's the worst thing anyone's said today." },
        { "voice": "shepard", "text": "It's also true. Shepard out." }
      ]
    }
  ]
