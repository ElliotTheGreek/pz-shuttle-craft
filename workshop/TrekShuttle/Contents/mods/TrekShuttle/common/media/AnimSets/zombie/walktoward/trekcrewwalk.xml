<?xml version="1.0" encoding="utf-8"?>
<!-- The Adirondack's crew walk like people (CREW.md 1). A crew member's walk
     type is TrekWalk (TREK_CrewClient sets it on every client every tick);
     the node plays the player's own walk. Bandits' zswalk.xml, own names. -->
<animNode>
	<m_Name>TrekCrewWalk</m_Name>
	<m_AnimName>Bob_Walk</m_AnimName>
	<m_deferredBoneAxis>Y</m_deferredBoneAxis>
	<m_SpeedScale>0.95</m_SpeedScale>
	<m_BlendTime>0.20</m_BlendTime>
	<m_Conditions>
		<m_Name>zombieWalkType</m_Name>
		<m_Type>STRING</m_Type>
		<m_Value>TrekWalk</m_Value>
	</m_Conditions>
	<m_Events>
		<m_EventName>Footstep</m_EventName>
		<m_TimePc>0.15</m_TimePc>
		<m_ParameterValue>walk</m_ParameterValue>
	</m_Events>
	<m_Events>
		<m_EventName>Footstep</m_EventName>
		<m_TimePc>0.6</m_TimePc>
		<m_ParameterValue>walk</m_ParameterValue>
	</m_Events>
</animNode>
